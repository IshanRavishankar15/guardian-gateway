# Local development defaults only. Never put real credentials in this file.
APP_ENV=development
POSTGRES_DB=guardian_gateway
POSTGRES_USER=guardian
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+asyncpg://guardian:change-me-locally@postgres:5432/guardian_gateway
REDIS_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=1.0
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_TOKEN=change-me-admin-token
ALLOWED_UPSTREAM_HOSTS=mock-upstream,localhost,127.0.0.1
MAX_GATEWAY_BODY_BYTES=10485760
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
